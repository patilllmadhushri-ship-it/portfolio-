---
// The CMS admin panel. Served as a real Astro route so /admin works in both
// `npm run dev` and production — the dev server won't serve a directory index
// out of public/, so this can't live in public/admin/index.html.
// The field definitions still live in public/admin/config.yml.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url" />
    <title>Content Manager</title>
  </head>
  <body>
    <script src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js" type="module"></script>
  </body>
</html>
